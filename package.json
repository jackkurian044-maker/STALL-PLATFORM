{
  "name": "stall-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "website": "npm --workspace apps/website run dev",
    "api": "npm --workspace apps/api run dev",
    "db:generate": "npm --workspace packages/database run generate",
    "db:migrate": "npm --workspace packages/database run migrate",
    "db:seed": "npm --workspace packages/database run seed",
    "build": "npm --workspace apps/website run build && npm --workspace apps/api run build"
  }
}
